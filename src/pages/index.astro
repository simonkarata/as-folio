---
import ProfilePhoto from '@components/about/ProfilePhoto.astro';
import SocialLinks from '@components/SocialLinks.astro';
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { getAuthors, getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import AboutContent from '../data/about.mdx';
import bibRaw from '../data/papers.bib?raw';

// Announcements
const allAnnouncements = site.announcements.enabled
  ? (await getCollection('announcements'))
      .filter((e) => !e.data.hidden)
      .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.getTime() - a.data.date.getTime();
      })
      .slice(0, site.announcements.limit)
  : [];

// Latest posts and the full set of published posts for the graph
const publishedPosts =
  site.latestPosts.enabled || site.noteGraph.enabled
    ? await getCollection('posts', (p) => !p.data.hidden && !p.data.draft)
    : [];
const sortedPosts = publishedPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allPosts = site.latestPosts.enabled ? sortedPosts.slice(0, site.latestPosts.limit) : [];
const graphPosts = site.noteGraph.enabled ? sortedPosts : [];
const graphNodes = graphPosts.map((post, index) => {
  const angle = index * 2.399963229728653;
  const radius = graphPosts.length === 1 ? 0 : Math.sqrt(index / (graphPosts.length - 1)) * 0.92;

  return {
    post,
    x: 380 + Math.cos(angle) * radius * 300,
    y: 300 + Math.sin(angle) * radius * 250,
  };
});
const graphEdges = graphNodes.flatMap((node, index) => {
  const targetIndices = [
    ...(index > 0 && index % 3 === 0 ? [index - 1] : []),
    ...(index > 2 && index % 5 === 0 ? [index - 3] : []),
  ];

  return targetIndices.map((targetIndex) => ({
    source: graphNodes[targetIndex],
    target: node,
  }));
});

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Selected publications
const selectedPapers = site.selectedPapers.enabled
  ? parseBibtex(bibRaw).filter((e) => getBoolField(e, 'selected'))
  : [];

// Pre-render announcement content
const renderedAnnouncements = await Promise.all(
  allAnnouncements.map(async (item) => ({ item, rendered: await render(item) })),
);
---

<Base isHome={true}>
  <div class="post page-container py-8">
    <header class="post-header">
      <h1
        class="post-title"
        style="font-family: var(--font-sans); color: var(--global-text-color);"
      >
        {(site.title as string) === 'blank' ? site.author.name : site.title}
      </h1>
      {
        site.author.subtitle && (
          <p
            class="desc"
            style="color: var(--global-text-color-light);"
            set:html={site.author.subtitle}
          />
        )
      }
    </header>

    <article>
      <!-- Profile photo (floats right by default) -->
      <ProfilePhoto align="right" />

      <div class="clearfix">
        <!-- Bio content from about.mdx -->
        <div class="prose max-w-none">
          <AboutContent />
        </div>
      </div>

      <!-- Social icons -->
      {
        site.socials && (
          <div class="social mt-6">
            <div class="contact-icons">
              <SocialLinks />
            </div>
          </div>
        )
      }

      <!-- Announcements / News -->
      {
        site.announcements.enabled && allAnnouncements.length > 0 && (
          <section class="mt-8">
            <h2 style="color: var(--global-text-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.3rem;">
              <a href={`${site.base}/news/`} style="color: inherit; text-decoration: none;">
                news
              </a>
            </h2>
            <div class={site.announcements.scrollable ? 'scrollable-list' : ''}>
              <table style="width: 100%; border-collapse: collapse;">
                <tbody>
                  {renderedAnnouncements.map(({ item, rendered: { Content } }) => (
                    <tr style="border-bottom: 1px solid var(--global-divider-color);">
                      <td style="padding: 0.5rem 1rem 0.5rem 0; white-space: nowrap; vertical-align: top; color: var(--global-text-color-light); font-size: 0.8rem;">
                        {formatDate(item.data.date)}
                      </td>
                      <td style="padding: 0.5rem 0; font-size: 0.9rem; color: var(--global-text-color);">
                        <Content />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <!-- Latest posts -->
      {
        site.latestPosts.enabled && allPosts.length > 0 && (
          <section class="mt-8">
            <h2 style="color: var(--global-text-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.3rem;">
              <a href={`${site.base}/blog/`} style="color: inherit; text-decoration: none;">
                latest posts
              </a>
            </h2>
            <div class={site.latestPosts.scrollable ? 'scrollable-list' : ''}>
              <table style="width: 100%; border-collapse: collapse;">
                <tbody>
                  {allPosts.map((post) => (
                    <tr style="border-bottom: 1px solid var(--global-divider-color);">
                      <td style="padding: 0.5rem 1rem 0.5rem 0; white-space: nowrap; vertical-align: top; color: var(--global-text-color-light); font-size: 0.8rem;">
                        {formatDate(post.data.date)}
                      </td>
                      <td style="padding: 0.5rem 0; font-size: 0.9rem;">
                        <a
                          href={`${site.base}/blog/${post.id}/`}
                          style="color: var(--global-theme-color); text-decoration: none;"
                        >
                          {post.data.title}
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <!-- Notes graph -->
      {
        site.noteGraph.enabled && graphNodes.length > 0 && (
          <section class="note-graph-section mt-8" aria-labelledby="note-graph-title">
            <h2 id="note-graph-title">
              <a href={`${site.base}/blog/`}>{site.noteGraph.title}</a>
            </h2>
            <p class="note-graph-description">{site.noteGraph.description}</p>
            <div class="note-graph-frame">
              <svg
                class="note-graph"
                viewBox="0 0 760 600"
                role="group"
                aria-label={site.noteGraph.description}
              >
                {graphEdges.map(({ source, target }) => (
                  <line
                    class="graph-edge"
                    x1={source.x}
                    y1={source.y}
                    x2={target.x}
                    y2={target.y}
                    data-source-index={graphNodes.indexOf(source)}
                    data-target-index={graphNodes.indexOf(target)}
                    aria-hidden="true"
                  />
                ))}
                {graphNodes.map(({ post, x, y }, index) => (
                  <a
                    class="graph-node"
                    href={`${site.base}/blog/${post.id}/`}
                    aria-label={post.data.title}
                  >
                    <title>{post.data.title}</title>
                    <g data-graph-node data-index={index} data-x={x} data-y={y}>
                      <circle cx={x} cy={y} r="5" />
                    </g>
                  </a>
                ))}
              </svg>
            </div>
          </section>
        )
      }

      <!-- Selected publications -->
      {
        site.selectedPapers.enabled && selectedPapers.length > 0 && (
          <section class="mt-8">
            <h2 style="color: var(--global-text-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.3rem;">
              <a href={`${site.base}/publications/`} style="color: inherit; text-decoration: none;">
                selected publications
              </a>
            </h2>
            <ol class="m-0 list-none p-0">
              {selectedPapers.map((entry) => {
                const title = getTitle(entry);
                const authors = getAuthors(entry);
                const venue = getVenue(entry);
                const year = getYear(entry);
                const abbr = entry.fields.abbr;
                const url =
                  entry.fields.html ??
                  (entry.fields.doi ? `https://doi.org/${entry.fields.doi}` : '');
                const award = entry.fields.award;
                return (
                  <li class="mb-4 text-sm" style="line-height: 1.6;">
                    {abbr && <span class="badge-abbr mr-2">{abbr}</span>}
                    {url ? (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        style="color: var(--global-text-color); font-weight: 600; text-decoration: none;"
                      >
                        {title}
                      </a>
                    ) : (
                      <strong style="color: var(--global-text-color);">{title}</strong>
                    )}
                    <br />
                    <span style="color: var(--global-text-color-light);">{authors}</span>
                    {(venue || year) && (
                      <>
                        {' · '}
                        <em style="color: var(--global-text-color-light);">
                          {venue}
                          {venue && year ? ', ' : ''}
                          {year || ''}
                        </em>
                      </>
                    )}
                    {award && (
                      <span class="badge-abbr ml-2" style="background-color: #f59e0b;">
                        {entry.fields.award_name ?? '🏆'}
                      </span>
                    )}
                  </li>
                );
              })}
            </ol>
            <p class="mt-2 text-sm">
              <a
                href={`${site.base}/publications/`}
                style="color: var(--global-theme-color); text-decoration: none;"
              >
                Full publication list &rarr;
              </a>
            </p>
          </section>
        )
      }
    </article>
  </div>
  <script>
    const graph = document.querySelector<SVGSVGElement>('.note-graph');

    if (graph) {
      const maxDriftPixels = (0.45 * 96) / 2.54;
      const nodes = Array.from(graph.querySelectorAll<SVGGElement>('[data-graph-node]')).map(
        (element) => {
          const randomOffset = () => {
            const angle = Math.random() * Math.PI * 2;
            const radius = Math.sqrt(Math.random()) * maxDriftPixels;
            return { x: Math.cos(angle) * radius, y: Math.sin(angle) * radius };
          };

          return {
            element,
            x: Number(element.dataset.x),
            y: Number(element.dataset.y),
            targets: Array.from({ length: 4 }, randomOffset),
            duration: 7000 + Math.random() * 9000,
            phase: Math.random(),
          };
        },
      );
      const edges = Array.from(graph.querySelectorAll<SVGLineElement>('.graph-edge')).map(
        (element) => ({
          element,
          source: Number(element.dataset.sourceIndex),
          target: Number(element.dataset.targetIndex),
        }),
      );
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      let animationFrame = 0;
      let startTime = 0;

      const stopMotion = () => {
        window.cancelAnimationFrame(animationFrame);
        nodes.forEach((node) => node.element.removeAttribute('transform'));
        edges.forEach(({ element }) => {
          const source = nodes[Number(element.dataset.sourceIndex)];
          const target = nodes[Number(element.dataset.targetIndex)];
          element.setAttribute('x1', String(source.x));
          element.setAttribute('y1', String(source.y));
          element.setAttribute('x2', String(target.x));
          element.setAttribute('y2', String(target.y));
        });
      };

      const animate = (time: number) => {
        if (!startTime) startTime = time;
        const scale = graph.getScreenCTM()?.a;

        if (!scale) {
          animationFrame = window.requestAnimationFrame(animate);
          return;
        }

        const elapsed = time - startTime;
        const offsets = nodes.map((node) => {
          const cycle = (((elapsed / node.duration + node.phase) % 1) + 1) % 1;
          const segment = cycle * node.targets.length;
          const index = Math.floor(segment);
          const progress = segment - index;
          const eased = progress * progress * (3 - 2 * progress);
          const from = node.targets[index];
          const to = node.targets[(index + 1) % node.targets.length];
          const offset = {
            x: (from.x + (to.x - from.x) * eased) / scale,
            y: (from.y + (to.y - from.y) * eased) / scale,
          };

          node.element.setAttribute('transform', `translate(${offset.x} ${offset.y})`);
          return offset;
        });

        edges.forEach(({ element, source, target }) => {
          const sourceNode = nodes[source];
          const targetNode = nodes[target];
          const sourceOffset = offsets[source];
          const targetOffset = offsets[target];
          element.setAttribute('x1', String(sourceNode.x + sourceOffset.x));
          element.setAttribute('y1', String(sourceNode.y + sourceOffset.y));
          element.setAttribute('x2', String(targetNode.x + targetOffset.x));
          element.setAttribute('y2', String(targetNode.y + targetOffset.y));
        });

        animationFrame = window.requestAnimationFrame(animate);
      };

      const syncMotion = () => {
        if (motionPreference.matches) {
          stopMotion();
        } else {
          startTime = 0;
          animationFrame = window.requestAnimationFrame(animate);
        }
      };

      motionPreference.addEventListener('change', syncMotion);
      syncMotion();
    }
  </script>
</Base>

<style>
  .clearfix::after {
    content: '';
    display: table;
    clear: both;
  }
  .post-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .desc {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  .note-graph-section h2 {
    color: var(--global-text-color);
    border-bottom: 1px solid var(--global-divider-color);
    padding-bottom: 0.3rem;
  }
  .note-graph-section h2 a {
    color: inherit;
    text-decoration: none;
  }
  .note-graph-description {
    color: var(--global-text-color-light);
    font-size: 0.85rem;
    margin: 0.6rem 0 0.8rem;
  }
  .note-graph-frame {
    overflow: hidden;
    border: 1px solid var(--global-divider-color);
    border-radius: 24px;
    background: var(--global-card-bg-color);
  }
  .note-graph {
    display: block;
    width: 100%;
    height: auto;
  }
  .graph-edge {
    stroke: var(--global-text-color-light);
    stroke-opacity: 0.24;
    stroke-width: 1.2;
  }
  .graph-node {
    color: var(--global-theme-color);
    cursor: pointer;
  }
  .graph-node circle {
    fill: currentColor;
    fill-opacity: 0.72;
    transition:
      fill-opacity 150ms ease,
      transform 150ms ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .graph-node:hover circle,
  .graph-node:focus-visible circle {
    fill-opacity: 1;
    transform: scale(1.45);
  }
  .graph-node:focus-visible {
    outline: none;
  }
</style>
